{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextBranch Study 2 curated task manifest",
  "type": "object",
  "required": [
    "schemaVersion", "taskId", "participantTitle", "provenance", "assets",
    "ticket", "rootBrief", "contextBranch", "runner", "submission", "privateGrader"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string" },
    "participantTitle": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["type", "sourceInstanceId", "datasetUrl", "sourceRepository", "sourceCommit", "derivedBehaviour", "construction"]
    },
    "assets": {
      "type": "object",
      "required": ["baselineDirectory", "referenceDirectory"]
    },
    "ticket": { "type": "object" },
    "rootBrief": { "type": "object" },
    "contextBranch": {
      "type": "object",
      "properties": {
        "siblingStates": { "type": "array", "minItems": 2, "maxItems": 2 }
      },
      "required": ["siblingStates"]
    },
    "runner": {
      "type": "object",
      "required": ["publicTestCommand", "runtime", "network"]
    },
    "submission": {
      "type": "object",
      "required": ["allowedProductionPaths", "finalState"]
    },
    "privateGrader": {
      "type": "object",
      "required": ["mode", "outcome", "hiddenGoals"]
    }
  }
}
