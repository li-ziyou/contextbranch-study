{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextBranch Study 2 curated task manifest",
  "type": "object",
  "required": [
    "schemaVersion", "taskId", "participantTitle", "provenance", "assets",
    "ticket", "contextBranch", "runner", "submission", "privateGrader"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string" },
    "participantTitle": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["type", "sourceInstanceId", "datasetUrl", "sourceRepository", "sourceCommit", "derivedBehaviour", "construction"]
    },
    "assets": {
      "type": "object",
      "required": ["baselineDirectory", "referenceDirectory"]
    },
    "ticket": {
      "type": "object",
      "required": ["summary", "requirements"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "mainTicketFile": { "type": "string", "minLength": 1 },
        "requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "contextBranch": {
      "type": "object",
      "properties": {
        "siblingStates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "label", "ticket"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "ticket": {
                "type": "object",
                "required": ["requirements"],
                "properties": {
                  "requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "finalVerification": { "type": "string" }
      },
      "required": ["siblingStates", "finalVerification"]
    },
    "runner": {
      "type": "object",
      "required": ["publicTestCommand", "runtime", "network"],
      "properties": {
        "publicTestCommand": { "type": "string", "minLength": 1 },
        "publicTestCommands": {
          "type": "object",
          "required": ["responsibilityA", "responsibilityB", "main"],
          "properties": {
            "responsibilityA": { "type": "string", "minLength": 1 },
            "responsibilityB": { "type": "string", "minLength": 1 },
            "main": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    },
    "submission": {
      "type": "object",
      "required": ["allowedProductionPaths", "finalState"]
    },
    "privateGrader": {
      "type": "object",
      "required": ["mode", "outcome", "hiddenGoals"]
    }
  }
}
